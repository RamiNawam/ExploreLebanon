# Copy to .env.local for local dev, and set the same two values in Netlify
# (Site configuration → Environment variables). Without them the app still runs,
# but pins are kept in your own browser instead of being shared.
#
# Supabase dashboard → Project Settings → Data API / API keys
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY
