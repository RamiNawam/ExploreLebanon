# Copy to .env.local for local dev, and set the same two values in Netlify
# (Site configuration → Environment variables). Without them the app still runs,
# but pins are kept in your own browser instead of being shared.
#
# Supabase dashboard → Settings → Data API → Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Supabase dashboard → Settings → API Keys → Publishable key (sb_publishable_...)
# The older "anon public" key from the Legacy API keys tab works too.
# Never put a secret / service_role key here — this file ships to the browser.
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY
